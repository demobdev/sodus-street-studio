{
  "installCommand": "npm ci && npm ci --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "framework": "vite",
  "functions": {"api/igloo.ts":{"includeFiles":"server/*.sql","maxDuration":180}},
  "crons": [{"path":"/api/igloo/jobs","schedule":"*/5 * * * *"}],
  "headers": [
    {"source":"/igloos/manage","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"Referrer-Policy","value":"no-referrer"}]},
    {"source":"/igloos/confirmation","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"Referrer-Policy","value":"no-referrer"}]},
    {"source":"/igloos/test-checkout","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"},{"key":"Referrer-Policy","value":"no-referrer"}]}
  ],
  "rewrites": [
    {"source":"/api/igloo/:route*","destination":"/api/igloo?route=:route*"},
    {"source":"/igloos","destination":"/igloos/index.html"},
    {"source":"/igloos/","destination":"/igloos/index.html"},
    {"source":"/about","destination":"/about/index.html"},
    {"source":"/about/","destination":"/about/index.html"},
    {"source":"/services","destination":"/services/index.html"},
    {"source":"/services/","destination":"/services/index.html"},
    {"source":"/studio-space","destination":"/studio-space/index.html"},
    {"source":"/studio-space/","destination":"/studio-space/index.html"},
    {"source":"/portfolio","destination":"/portfolio/index.html"},
    {"source":"/portfolio/","destination":"/portfolio/index.html"},
    {"source":"/booking","destination":"/booking/index.html"},
    {"source":"/booking/","destination":"/booking/index.html"},
    {"source":"/faq","destination":"/faq/index.html"},
    {"source":"/faq/","destination":"/faq/index.html"},
    {"source":"/contact","destination":"/contact/index.html"},
    {"source":"/contact/","destination":"/contact/index.html"},
    {"source":"/privacy-policy","destination":"/privacy-policy/index.html"},
    {"source":"/privacy-policy/","destination":"/privacy-policy/index.html"},
    {"source":"/terms-and-conditions","destination":"/terms-and-conditions/index.html"},
    {"source":"/terms-and-conditions/","destination":"/terms-and-conditions/index.html"},
    {"source":"/igloos/manage","destination":"/igloos/manage/index.html"},
    {"source":"/igloos/manage/","destination":"/igloos/manage/index.html"},
    {"source":"/igloos/confirmation","destination":"/igloos/confirmation/index.html"},
    {"source":"/igloos/confirmation/","destination":"/igloos/confirmation/index.html"},
    {"source":"/igloos/test-checkout","destination":"/igloos/test-checkout/index.html"},
    {"source":"/igloos/test-checkout/","destination":"/igloos/test-checkout/index.html"},
    {"source":"/(.*)","destination":"/index.html"}
  ]
}
